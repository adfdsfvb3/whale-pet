{
  "name": "whale-pet",
  "version": "1.0.0",
  "description": "鲸鱼娘桌面宠物（WhalePet）—— Electron 跨平台版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.whalepet",
    "productName": "WhalePet",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "frames/**",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "WhalePet-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
